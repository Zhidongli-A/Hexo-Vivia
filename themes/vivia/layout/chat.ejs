<article id="page-<%= page.slug %>" class="h-entry article article-type-page chat-page" itemprop="blogPost" itemscope itemtype="https://schema.org/BlogPosting">
<style>body{background:transparent;overflow:hidden;height:100%;}html{overflow:hidden;height:100%;}</style>
  <div class="article-inner">
    <div class="article-main chat-page-main">
      <header class="article-header">
        <%- partial('_partial/post/title', {post: page, index: false, class_name: 'p-name article-title'}) %>
        <div class="meta-info-bar">
          <div class="meta-info">
            
          </div>
        </div>
      </header>
      <div style="position:fixed;top:0;left:0;width:100%;height:100%;border:none;background:transparent;overflow:auto;">
  <iframe src="https://easymodelapi.zhidongli.top" style="width:100%;height:100%;border:none;" allow="fullscreen" allowtransparency="true"></iframe>
</div>
    </div>
  </div>
</article>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
<script src="https://cdn.jsdelivr.net/npm/marked@12.0.0/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
<script src="<%- url_for('/js/chat.js') %>"></script>
