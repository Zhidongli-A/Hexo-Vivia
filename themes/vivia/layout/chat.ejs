<article id="page-<%= page.slug %>" class="h-entry article article-type-page chat-page" itemprop="blogPost" itemscope itemtype="https://schema.org/BlogPosting">
  <div class="article-inner">
    <div class="article-main chat-page-main">
      <header class="article-header">
        <%- partial('_partial/post/title', {post: page, index: false, class_name: 'p-name article-title'}) %>
        <div class="meta-info-bar">
          <div class="meta-info">
            <i class="fa-regular fa-comment-dots"></i> 与 AI 对话
          </div>
        </div>
      </header>
      <div class="e-content article-entry chat-page-entry" itemprop="articleBody">

        <div id="chat-messages" class="chat-messages">
          <div class="chat-msg chat-msg-bot chat-msg-welcome">
            <div class="chat-bubble">
              有什么想聊的？可以直接在下方输入。
            </div>
          </div>
        </div>

        <form id="chat-form" class="chat-input-bar" autocomplete="off">
          <div class="chat-input-wrap">
            <textarea id="chat-input" class="chat-input" rows="1" maxlength="2000"></textarea>
            <button id="chat-send" class="chat-send-btn" type="submit">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4 20-7Z"/><path d="M22 2 11 13"/></svg>
            </button>
          </div>
        </form>

        <%- page.content %>

      </div>
    </div>
  </div>
</article>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
<script src="https://cdn.jsdelivr.net/npm/marked@12.0.0/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
<script src="<%- url_for('/js/chat.js') %>"></script>
